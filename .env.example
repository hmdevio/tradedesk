# Copy to .env. Never commit real secrets.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-before-running
DATABASE_URL=sqlite:///./tradedesk.db
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=
# Redis shared rate-limit store. Required in production.
REDIS_URL=redis://localhost:6379/0
# Comma-separated trusted proxy CIDRs; leave empty unless behind known proxies.
TRUSTED_PROXY_CIDRS=
# Optional future integration. Do not set unless configured in code for a trusted provider.
AI_API_KEY=
ENVIRONMENT=development
