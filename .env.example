# Copy to .env. Never commit real secrets.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in every environment: at least 32 random characters. The app refuses
# to start with this placeholder or a shorter key.
SECRET_KEY=replace-with-a-long-random-secret-before-running
DATABASE_URL=sqlite:///./tradedesk.db
ACCESS_TOKEN_MINUTES=30
# Absolute session limit: "Stay signed in" cannot extend a session past this
# many hours after sign-in. Must be at least ACCESS_TOKEN_MINUTES.
SESSION_MAX_HOURS=12
CORS_ORIGINS=
# Redis shared rate-limit store. Required in production.
REDIS_URL=redis://localhost:6379/0
# Comma-separated trusted proxy CIDRs; leave empty unless behind known proxies.
TRUSTED_PROXY_CIDRS=
# Required: development, test or production. There is no default, so a
# missing value can no longer silently run with development settings.
ENVIRONMENT=development
# Password reset link lifetime in minutes.
PASSWORD_RESET_MINUTES=30

# Email delivery for verification and password reset links.
# APP_BASE_URL is used to build the links; production requires https://.
APP_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Use STARTTLS (port 587) or implicit TLS (port 465), not both.
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
